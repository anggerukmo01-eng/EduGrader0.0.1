import React, { useState, useRef } from 'react';
import { UploadCloud, CheckCircle, AlertCircle, FileText, Loader2, Image as ImageIcon, User, Download, Table as TableIcon, BookOpen, Users, Database, Plus, School } from 'lucide-react';

const apiKey = ""; // API Key akan diisi otomatis oleh environment

// Data default yang telah diperbarui sesuai gambar
const defaultStudents = [
  { nisn: '3186088743', name: 'ATHA ZAFRAN RAMADHAN', jk: 'L' },
  { nisn: '3184668441', name: 'Cakra Abiyasa', jk: 'L' },
  { nisn: '3198245070', name: 'DELIA ZAHRA SALSABILA', jk: 'P' },
  { nisn: '3182191613', name: 'Elvano Akmal Dwitama', jk: 'L' },
  { nisn: '3180097773', name: 'Fajar Askari Ramdani', jk: 'L' },
  { nisn: '3190609374', name: 'FARRA AYSHA AZZAHRA', jk: 'P' },
  { nisn: '3196928983', name: 'Fauziah Hasni Faiq Syarif', jk: 'P' },
  { nisn: '3176829400', name: 'FELLISA PUTRI HIDAYAT', jk: 'P' },
  { nisn: '3194416472', name: 'GHALI NUFAIL TSAMARADANIE', jk: 'L' },
  { nisn: '3181245719', name: 'GILANG ARJUNA RAMADHAN', jk: 'L' },
  { nisn: '3185432764', name: 'HAFIT RAMADHANI SAFUTRA', jk: 'L' },
  { nisn: '3198630567', name: 'Kesya Lutfia Alhanisputri', jk: 'P' },
  { nisn: '3180176114', name: 'MAULANA YUSUF ALFARIZQI', jk: 'L' },
  { nisn: '3185715005', name: 'MUHAMMAD ABDILAH MUZAQI', jk: 'L' },
  { nisn: '3195455121', name: 'Rafasya Alvin Faaz', jk: 'L' },
  { nisn: '3195732811', name: 'Randy Prasetya', jk: 'L' },
  { nisn: '3197098742', name: 'RIVANDRA LUJA ANUGRAH', jk: 'L' },
  { nisn: '3180556733', name: 'WISNU ARYA KENCANA', jk: 'L' },
  { nisn: '3194871087', name: 'YUSUF AFKA RIANSYAH', jk: 'L' },
];

const subjectsList = [
  'PPKn',
  'Bahasa Indonesia',
  'Matematika',
  'Seni Rupa',
  'Bahasa Jawa'
];

export default function App() {
  // Navigation State
  const [activeTab, setActiveTab] = useState('koreksi'); // 'koreksi' | 'database'

  // Identitas Sekolah State
  const [schoolInfo, setSchoolInfo] = useState({
    name: 'SD Negeri 1 Gerduren',
    year: '2025/2026',
    grade: '1'
  });

  // Database Siswa State
  const [students, setStudents] = useState(defaultStudents);
  const [newStudent, setNewStudent] = useState({ nisn: '', name: '', jk: 'L' });

  // Koreksi State
  const [imagePreview, setImagePreview] = useState(null);
  const [base64Image, setBase64Image] = useState(null);
  const [mimeType, setMimeType] = useState(null);
  const [answerKey, setAnswerKey] = useState('');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);
  const [subject, setSubject] = useState('PPKn');
  const [selectedStudentNisn, setSelectedStudentNisn] = useState('');
  const [records, setRecords] = useState([]);
  
  const fileInputRef = useRef(null);

  // --- Handlers untuk Database Siswa ---
  const handleAddStudent = (e) => {
    e.preventDefault();
    if (!newStudent.nisn || !newStudent.name) {
      alert("NISN dan Nama Siswa harus diisi!");
      return;
    }
    setStudents([...students, newStudent]);
    setNewStudent({ nisn: '', name: '', jk: 'L' }); // Reset form
    alert("Data siswa berhasil ditambahkan!");
  };

  const handleSchoolInfoChange = (e, field) => {
    setSchoolInfo({ ...schoolInfo, [field]: e.target.value });
  };

  // --- Handlers untuk Koreksi ---
  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      setError('Silakan unggah file gambar (JPG/PNG).');
      return;
    }
    setMimeType(file.type);
    setError(null);
    setResult(null);

    const reader = new FileReader();
    reader.onloadend = () => {
      setImagePreview(reader.result);
      const base64String = reader.result.split(',')[1];
      setBase64Image(base64String);
    };
    reader.readAsDataURL(file);
  };

  const triggerFileInput = () => fileInputRef.current.click();

  const downloadExcel = () => {
    if (records.length === 0) return;
    const headers = ['Sekolah', 'Tahun Pelajaran', 'Kelas', 'Waktu', 'Mata Pelajaran', 'NISN', 'Nama Siswa', 'Nilai Akhir'];
    const csvContent = [
      headers.join(','),
      ...records.map(r => `"${r.schoolName}","${r.academicYear}","${r.gradeClass}","${r.timestamp}","${r.subject}","${r.studentId}","${r.studentName}","${r.score}"`)
    ].join('\n');
    
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `Rekap_Nilai_${schoolInfo.name.replace(/\s+/g, '_')}_Kls${schoolInfo.grade}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  const fetchWithRetry = async (url, options, maxRetries = 5) => {
    const delays = [1000, 2000, 4000, 8000, 16000];
    for (let i = 0; i < maxRetries; i++) {
      try {
        const response = await fetch(url, options);
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        return await response.json();
      } catch (err) {
        if (i === maxRetries - 1) throw err;
        await delay(delays[i]);
      }
    }
  };

  const gradeExam = async () => {
    if (!base64Image) {
      setError('Silakan unggah foto jawaban siswa terlebih dahulu.');
      return;
    }
    if (!selectedStudentNisn) {
      setError('Silakan pilih data siswa dari dropdown terlebih dahulu.');
      return;
    }

    setLoading(true);
    setError(null);
    setResult(null);

    const prompt = `
      Kamu adalah seorang guru ahli untuk mata pelajaran ${subject}. 
      Tugasmu adalah mengoreksi lembar jawaban siswa dari gambar yang diberikan.
      
      Kunci Jawaban dan Kriteria Penilaian:
      ${answerKey ? answerKey : "Gunakan pengetahuan dan kaidah keilmuan yang tepat untuk mata pelajaran " + subject + " dalam menilai jawaban secara objektif."}
      
      Tugasmu:
      1. Baca teks pada gambar lembar jawaban siswa dengan cermat. Perhatikan baik-baik tulisan tangan, rumus (jika ada), atau ejaan.
      2. Bandingkan jawaban siswa dengan kunci jawaban atau pedoman standar mata pelajaran ${subject}.
      3. Berikan penilaian terstruktur.
      
      PENTING: Pada baris pertama responmu, kamu WAJIB menuliskan format persis seperti ini: NILAI_AKHIR: [angka 0-100]. 
      Contoh: NILAI_AKHIR: 85
      
      Setelah itu, lanjutkan dengan format berikut:
         - **Analisis Jawaban**: (Sebutkan nomor/bagian soal, jawaban siswa, dan status Benar/Salah beserta alasan singkat sesuai konteks pelajaran ${subject})
         - **Saran**: (Saran perbaikan singkat untuk siswa)
    `;

    try {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
      const payload = {
        contents: [
          {
            role: "user",
            parts: [
              { text: prompt },
              { inlineData: { mimeType: mimeType || "image/jpeg", data: base64Image } }
            ]
          }
        ]
      };

      const data = await fetchWithRetry(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (data && data.candidates && data.candidates.length > 0) {
        const textResponse = data.candidates[0].content.parts[0].text;
        setResult(textResponse);
        
        const scoreMatch = textResponse.match(/NILAI_AKHIR[^\d]*(\d+)/i);
        const score = scoreMatch ? parseInt(scoreMatch[1], 10) : 'N/A';
        
        // Cari nama siswa berdasarkan NISN yang dipilih
        const selectedStudent = students.find(s => s.nisn === selectedStudentNisn);
        
        const newRecord = {
          id: Date.now(),
          studentName: selectedStudent ? selectedStudent.name : 'Unknown',
          studentId: selectedStudentNisn,
          subject: subject,
          score: score,
          timestamp: new Date().toLocaleString('id-ID'),
          schoolName: schoolInfo.name,
          academicYear: schoolInfo.year,
          gradeClass: schoolInfo.grade
        };
        setRecords(prev => [...prev, newRecord]);
      } else {
        throw new Error("Respon dari AI tidak valid.");
      }
    } catch (err) {
      console.error(err);
      setError("Gagal mengoreksi jawaban. Pastikan koneksi internet stabil atau coba lagi beberapa saat.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans">
      
      {/* Navbar / Menu Tabs */}
      <nav className="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-10">
        <div className="max-w-6xl mx-auto px-4 md:px-8">
          <div className="flex flex-col md:flex-row md:items-center justify-between py-4 gap-4">
            <div>
              <h1 className="text-2xl font-bold text-indigo-700 flex items-center gap-2">
                <CheckCircle className="w-6 h-6" />
                EduGrader AI
              </h1>
              <p className="text-xs text-slate-500 mt-1 font-medium flex items-center gap-1">
                <School className="w-3 h-3" />
                {schoolInfo.name} • Tahun {schoolInfo.year} • Kelas {schoolInfo.grade}
              </p>
            </div>
            <div className="flex bg-slate-100 p-1 rounded-xl w-full md:w-auto overflow-x-auto">
              <button
                onClick={() => setActiveTab('koreksi')}
                className={`flex-1 md:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
                  activeTab === 'koreksi' ? 'bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-700'
                }`}
              >
                <ImageIcon className="w-4 h-4" />
                Koreksi Ujian
              </button>
              <button
                onClick={() => setActiveTab('database')}
                className={`flex-1 md:flex-none flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
                  activeTab === 'database' ? 'bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-700'
                }`}
              >
                <Database className="w-4 h-4" />
                Database Siswa
              </button>
            </div>
          </div>
        </div>
      </nav>

      <div className="p-4 md:p-8 max-w-6xl mx-auto">
        
        {/* =========================================
            TAB 1: KOREKSI UJIAN
            ========================================= */}
        {activeTab === 'koreksi' && (
          <div className="space-y-6 animate-in fade-in duration-300">
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* Kolom Input */}
              <div className="space-y-6">
                
                {/* Input Data Siswa & Mapel */}
                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                  <label className="flex items-center gap-2 font-semibold text-slate-700 mb-4">
                    <User className="w-5 h-5 text-indigo-500" />
                    Data Koreksi
                  </label>
                  
                  <div className="space-y-4">
                    {/* Pilihan Mata Pelajaran */}
                    <div>
                      <label className="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                        <BookOpen className="w-3.5 h-3.5" /> Mata Pelajaran
                      </label>
                      <select
                        value={subject}
                        onChange={(e) => setSubject(e.target.value)}
                        className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-sm bg-white cursor-pointer"
                      >
                        {subjectsList.map((item, idx) => (
                          <option key={idx} value={item}>{item}</option>
                        ))}
                      </select>
                    </div>

                    {/* Dropdown Pilihan Siswa */}
                    <div>
                      <label className="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                        <Users className="w-3.5 h-3.5" /> Pilih Siswa (Kelas {schoolInfo.grade})
                      </label>
                      <select
                        value={selectedStudentNisn}
                        onChange={(e) => setSelectedStudentNisn(e.target.value)}
                        className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-sm bg-white cursor-pointer"
                      >
                        <option value="" disabled>-- Pilih Nama Siswa --</option>
                        {students.map((std, idx) => (
                          <option key={idx} value={std.nisn}>
                            {std.name} (NISN: {std.nisn})
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                </div>

                {/* Input Kunci Jawaban */}
                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                  <label className="flex items-center gap-2 font-semibold text-slate-700 mb-2">
                    <FileText className="w-5 h-5 text-indigo-500" />
                    Kunci Jawaban & Panduan (Opsional)
                  </label>
                  <textarea
                    className="w-full h-28 p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none resize-none transition-all text-sm"
                    placeholder="Contoh:&#10;1. Ibu Kota Indonesia adalah Jakarta (Poin 20)&#10;2. 5 x 5 = 25 (Poin 20)&#10;Dst..."
                    value={answerKey}
                    onChange={(e) => setAnswerKey(e.target.value)}
                  />
                </div>

                {/* Upload Area */}
                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                  <label className="flex items-center gap-2 font-semibold text-slate-700 mb-2">
                    <ImageIcon className="w-5 h-5 text-indigo-500" />
                    Foto Jawaban Siswa
                  </label>
                  <input
                    type="file"
                    accept="image/*"
                    ref={fileInputRef}
                    className="hidden"
                    onChange={handleImageUpload}
                  />
                  
                  {!imagePreview ? (
                    <div 
                      onClick={triggerFileInput}
                      className="w-full h-40 border-2 border-dashed border-slate-300 rounded-xl flex flex-col items-center justify-center text-slate-500 hover:bg-slate-50 hover:border-indigo-400 cursor-pointer transition-all"
                    >
                      <UploadCloud className="w-10 h-10 mb-2 text-slate-400" />
                      <span className="font-medium text-sm">Klik untuk mengunggah foto</span>
                      <span className="text-xs mt-1">Mendukung JPG, PNG</span>
                    </div>
                  ) : (
                    <div className="relative w-full rounded-xl overflow-hidden border border-slate-200 group">
                      <img src={imagePreview} alt="Preview" className="w-full h-auto max-h-56 object-contain bg-slate-100" />
                      <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <button 
                          onClick={triggerFileInput}
                          className="bg-white text-slate-800 px-4 py-2 rounded-lg font-medium text-sm shadow-lg hover:bg-slate-100"
                        >
                          Ganti Foto
                        </button>
                      </div>
                    </div>
                  )}
                </div>

                {/* Tombol Aksi */}
                <button
                  onClick={gradeExam}
                  disabled={loading || !base64Image || !selectedStudentNisn}
                  className={`w-full py-3.5 rounded-xl font-bold text-white shadow-md transition-all flex items-center justify-center gap-2
                    ${loading || !base64Image || !selectedStudentNisn
                      ? 'bg-slate-400 cursor-not-allowed' 
                      : 'bg-indigo-600 hover:bg-indigo-700 hover:shadow-lg active:scale-[0.98]'}`}
                >
                  {loading ? (
                    <>
                      <Loader2 className="w-5 h-5 animate-spin" />
                      Menganalisis Jawaban...
                    </>
                  ) : (
                    'Koreksi Sekarang'
                  )}
                </button>

                {error && (
                  <div className="bg-red-50 text-red-600 p-4 rounded-xl flex items-start gap-3 border border-red-200">
                    <AlertCircle className="w-5 h-5 shrink-0 mt-0.5" />
                    <p className="text-sm">{error}</p>
                  </div>
                )}
              </div>

              {/* Kolom Hasil */}
              <div className="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-slate-200 h-full min-h-[400px]">
                 <h2 className="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2 border-b pb-3">
                   Hasil Koreksi AI
                 </h2>
                 
                 {loading ? (
                   <div className="h-64 flex flex-col items-center justify-center text-slate-400 space-y-4">
                     <Loader2 className="w-10 h-10 animate-spin text-indigo-500" />
                     <p className="text-sm text-center">
                       AI sedang membaca tulisan tangan untuk pelajaran <b>{subject}</b><br/>dan membandingkannya dengan kunci...
                     </p>
                   </div>
                 ) : result ? (
                   <div className="prose prose-slate max-w-none text-slate-700 text-sm md:text-base">
                     <div className="whitespace-pre-wrap font-medium">
                       {result}
                     </div>
                   </div>
                 ) : (
                   <div className="h-64 flex flex-col items-center justify-center text-slate-400 text-center">
                     <CheckCircle className="w-12 h-12 mb-3 opacity-20" />
                     <p className="text-sm">Hasil koreksi akan muncul di sini setelah Anda mengklik tombol <b>Koreksi Sekarang</b>.</p>
                   </div>
                 )}
              </div>
            </div>

            {/* Tabel Rekap Nilai */}
            {records.length > 0 && (
              <div className="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-slate-200 mt-8">
                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-4 border-b border-slate-100 pb-4">
                  <h2 className="text-xl font-bold text-slate-800 flex items-center gap-2">
                    <TableIcon className="w-6 h-6 text-indigo-600" />
                    Rekap Daftar Nilai
                  </h2>
                  <button
                    onClick={downloadExcel}
                    className="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl font-medium shadow-sm transition-all flex items-center gap-2 text-sm active:scale-95"
                  >
                    <Download className="w-4 h-4" />
                    Unduh Rekap (.CSV)
                  </button>
                </div>
                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse min-w-[700px]">
                    <thead>
                      <tr className="bg-slate-50 text-slate-600 border-b border-slate-200 text-sm">
                        <th className="p-3 font-semibold rounded-tl-lg">Waktu</th>
                        <th className="p-3 font-semibold">Mapel</th>
                        <th className="p-3 font-semibold">NISN</th>
                        <th className="p-3 font-semibold">Nama Siswa</th>
                        <th className="p-3 font-semibold text-center rounded-tr-lg">Nilai Akhir</th>
                      </tr>
                    </thead>
                    <tbody>
                      {records.map((record) => (
                        <tr key={record.id} className="border-b border-slate-100 hover:bg-slate-50 transition-colors text-sm">
                          <td className="p-3 text-slate-500 whitespace-nowrap">{record.timestamp}</td>
                          <td className="p-3 font-medium text-indigo-600">{record.subject}</td>
                          <td className="p-3 font-medium text-slate-700">{record.studentId}</td>
                          <td className="p-3 font-medium text-slate-700">{record.studentName}</td>
                          <td className="p-3 text-center">
                            <span className={`px-3 py-1 rounded-full font-bold text-xs inline-block min-w-[3rem] ${
                              record.score === 'N/A' ? 'bg-slate-100 text-slate-600' :
                              record.score >= 75 ? 'bg-green-100 text-green-700' :
                              record.score >= 50 ? 'bg-yellow-100 text-yellow-700' :
                              'bg-red-100 text-red-700'
                            }`}>
                              {record.score}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}

        {/* =========================================
            TAB 2: DATABASE SISWA
            ========================================= */}
        {activeTab === 'database' && (
          <div className="space-y-6 animate-in fade-in duration-300">
            
            {/* Form Identitas Sekolah */}
            <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
              <h2 className="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2 border-b pb-3">
                <School className="w-5 h-5 text-indigo-500" />
                Identitas Sekolah & Kelas
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label className="block text-xs font-medium text-slate-500 mb-1">Nama Sekolah</label>
                  <input
                    type="text"
                    className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm"
                    value={schoolInfo.name}
                    onChange={(e) => handleSchoolInfoChange(e, 'name')}
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-slate-500 mb-1">Tahun Pelajaran</label>
                  <input
                    type="text"
                    className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm"
                    value={schoolInfo.year}
                    onChange={(e) => handleSchoolInfoChange(e, 'year')}
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-slate-500 mb-1">Kelas</label>
                  <input
                    type="text"
                    className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm"
                    value={schoolInfo.grade}
                    onChange={(e) => handleSchoolInfoChange(e, 'grade')}
                  />
                </div>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {/* Form Tambah Siswa */}
              <div className="md:col-span-1">
                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 sticky top-24">
                  <h2 className="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2 border-b pb-3">
                    <Plus className="w-5 h-5 text-indigo-500" />
                    Tambah Siswa Baru
                  </h2>
                  <form onSubmit={handleAddStudent} className="space-y-4">
                    <div>
                      <label className="block text-xs font-medium text-slate-500 mb-1">NISN / Nomor Induk</label>
                      <input
                        type="text"
                        required
                        className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm"
                        placeholder="Contoh: 0108331165"
                        value={newStudent.nisn}
                        onChange={(e) => setNewStudent({...newStudent, nisn: e.target.value})}
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-slate-500 mb-1">Nama Lengkap</label>
                      <input
                        type="text"
                        required
                        className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm"
                        placeholder="Contoh: Budi Santoso"
                        value={newStudent.name}
                        onChange={(e) => setNewStudent({...newStudent, name: e.target.value.toUpperCase()})}
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-slate-500 mb-1">Jenis Kelamin</label>
                      <select
                        className="w-full p-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white"
                        value={newStudent.jk}
                        onChange={(e) => setNewStudent({...newStudent, jk: e.target.value})}
                      >
                        <option value="L">Laki-Laki (L)</option>
                        <option value="P">Perempuan (P)</option>
                      </select>
                    </div>
                    <button
                      type="submit"
                      className="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl font-semibold shadow-sm transition-all text-sm mt-2"
                    >
                      Simpan Data
                    </button>
                  </form>
                </div>
              </div>

              {/* Tabel Master Siswa */}
              <div className="md:col-span-2">
                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                  <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                    <h2 className="text-lg font-bold text-slate-800 flex items-center gap-2">
                      <Database className="w-5 h-5 text-indigo-500" />
                      Daftar Master Siswa
                    </h2>
                    <span className="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-bold">
                      Total: {students.length} Siswa
                    </span>
                  </div>
                  
                  <div className="overflow-x-auto max-h-[600px] overflow-y-auto">
                    <table className="w-full text-left border-collapse">
                      <thead className="sticky top-0 bg-slate-50 z-10">
                        <tr className="text-slate-600 border-b border-slate-200 text-sm">
                          <th className="p-3 font-semibold">No</th>
                          <th className="p-3 font-semibold">NISN</th>
                          <th className="p-3 font-semibold">Nama Lengkap</th>
                          <th className="p-3 font-semibold text-center">L/P</th>
                        </tr>
                      </thead>
                      <tbody>
                        {students.map((std, idx) => (
                          <tr key={idx} className="border-b border-slate-100 hover:bg-slate-50 transition-colors text-sm">
                            <td className="p-3 text-slate-500">{idx + 1}</td>
                            <td className="p-3 font-medium text-slate-700">{std.nisn}</td>
                            <td className="p-3 font-semibold text-slate-800">{std.name}</td>
                            <td className="p-3 text-center">
                              <span className={`px-2 py-1 rounded-md text-xs font-bold ${
                                std.jk === 'L' ? 'bg-blue-100 text-blue-700' : 'bg-pink-100 text-pink-700'
                              }`}>
                                {std.jk}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
              
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
